# Gmail SMTP（你之前提供的配置够用）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=junleli0603@gmail.com
SMTP_PASSWORD=你的Gmail应用专用密码
SMTP_FROM=junleli0603@gmail.com
SMTP_USE_TLS=true

# 允许访问 API 的前端域名（逗号分隔）
ALLOWED_ORIGINS=https://lamaea.github.io,http://127.0.0.1:8080,http://localhost:8080

# 发送口令：网页里填写同样口令才能发信（不要写进前端代码仓库）
SEND_API_KEY=请设置一个长随机字符串
